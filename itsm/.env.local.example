# 이 파일을 .env.local 로 복사해 쓰세요. (.env.local 은 Git 추적에서 제외됩니다)
# ITSM 웹이 ITSM API 에 접속하는 정보 (생략하면 아래 개발용 기본값 사용)
# ITSM_BASE_URL=http://127.0.0.1:8001
# ITSM_CLIENT_ID=portal
# ITSM_CLIENT_SECRET=portal-dev-secret
# ITSM_TIMEOUT_SECONDS=10
# 별도 ITSM Agent 서비스 (../itsm_dlc, 기본 :8100)
# ITSM_AGENT_BASE_URL=http://127.0.0.1:8100
# 모델 응답을 기다리는 BFF 제한 시간
# ITSM_AGENT_TIMEOUT_SECONDS=120
